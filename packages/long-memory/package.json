{
  "name": "@megasaver/long-memory",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Evidence-backed long-memory contracts for Mega Saver.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "megasaver-long-memory": "./dist/stdio.js",
    "megasaver-long-memory-lm2-benchmark": "./dist/lm2-benchmark.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ranker": {
      "types": "./dist/lm2-ranker-entry.d.ts",
      "import": "./dist/lm2-ranker-entry.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@megasaver/retrieval": "workspace:*",
    "@megasaver/shared": "workspace:*",
    "fs-ext": "^2.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/fs-ext": "^2.0.3",
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0"
  }
}
